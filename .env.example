# Optional Parquet dataset directory. Defaults to ./data/parquet.
# Set this when deployment data is mounted outside the application directory.
OLIST_PARQUET_DIR=

# Optional source CSV directory used only to rebuild missing Parquet datasets.
# Defaults to the project root.
OLIST_CSV_DIR=

# Optional prebuilt SQLite database path. When set, SQLite takes precedence
# over Parquet. Leave empty to use the committed Parquet datasets.
OLIST_DB_PATH=
