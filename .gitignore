# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Test and tooling caches
.pytest_cache/
.cache/
cache/
.streamlit/cache/
.coverage
htmlcov/
