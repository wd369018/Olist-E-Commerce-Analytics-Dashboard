# OS / editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local logs and exports
*.log

# Large raw CSV datasets (prevent pushing large files to GitHub)
*.csv
processed/*.csv

# Local data extracts; retain the versioned deployment Parquet source.
*.parquet
!data/parquet/*.parquet
*.db
*.sqlite
*.sqlite3
*.feather
*.h5
*.hdf5
